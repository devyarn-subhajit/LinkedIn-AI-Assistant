{
  "manifest_version": 3,
  "name": "LinkedIn AI Assistant",
  "version": "2.1.0",
  "description": "AI-powered LinkedIn engagement assistant — smart comments, DM replies, and conversation analysis. Developed by Devyarn (www.devyarn.com).",
  "author": "Devyarn",
  "homepage_url": "https://www.devyarn.com",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["settings.js", "storage.js", "ai.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn AI Assistant"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
